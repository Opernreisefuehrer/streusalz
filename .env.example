SITE_URL=http://localhost:3000
# Production search indexing is separate from checkout; Vercel previews stay blocked.
# Set true only for Production with SITE_URL=https://www.streusalz-grosshandel.de.
SITE_INDEXING_ENABLED=false
# Live checkout is deliberately disabled until legal content and operations are ready.
SHOP_ENABLED=false
LEGAL_READY=false
# Local development uses persistent PGlite in .local-db; Vercel requires PostgreSQL.
DATABASE_URL=
# OpenRouteService: geocoding + driving-hgv routing. Never NEXT_PUBLIC_!
ORS_API_KEY=
ADMIN_EMAIL=info@streusalz-grosshandel.de
# Generate a hash with npm run admin:password -- "your-long-password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters; never commit the real value.
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@streusalz-grosshandel.de
# Preview writes .eml files locally, NEVER usable on Vercel or in production.
MAIL_MODE=preview
# Complete legal texts are generated from src/lib/legal.ts. Optional reviewed overrides:
TERMS_TEXT=
PRIVACY_TEXT=
LEGAL_VERSION=2026-11-01
PRIVACY_CONTACT_EMAIL=datenschutz@streusalz-grosshandel.de
# Actual production providers and reviewed retention/transfer arrangements are mandatory.
PRIVACY_DATABASE_PROVIDER=
PRIVACY_DATABASE_COUNTRY=
PRIVACY_MAIL_PROVIDER=
PRIVACY_MAIL_COUNTRY=
PRIVACY_HOSTING_LOG_RETENTION_DAYS=
PRIVACY_TRANSFER_DETAILS=
SELLER_NAME=Albino Cipolla
SELLER_STREET=Nahestr. 5
SELLER_POSTCODE=55118
SELLER_CITY=Mainz
SELLER_PHONE=01523-6183155
SELLER_EMAIL=info@streusalz-grosshandel.de
# SELLER_TAX_ID is for invoices only; never displayed in the public imprint.
SELLER_TAX_ID=
# Only public VAT/economic identification numbers belong in the imprint, if assigned.
SELLER_VAT_ID=
SELLER_WID=
SELLER_BANK_NAME=
SELLER_IBAN=
SELLER_BIC=
# Protect the Vercel mail-outbox cron.
CRON_SECRET=
