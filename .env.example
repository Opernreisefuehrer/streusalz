SITE_URL=http://localhost:3000
# Live checkout is deliberately disabled until legal content and operations are ready.
SHOP_ENABLED=false
LEGAL_READY=false
# Local development uses persistent PGlite in .local-db; Vercel requires PostgreSQL.
DATABASE_URL=
# OpenRouteService: geocoding + driving-hgv routing. Never NEXT_PUBLIC_!
ORS_API_KEY=
ADMIN_EMAIL=info@streusalz-grosshandel.de
# Generate a hash with npm run admin:password -- "your-long-password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters; never commit the real value.
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@streusalz-grosshandel.de
# Preview writes .eml files locally, NEVER usable on Vercel or in production.
MAIL_MODE=preview
# Put these legal texts in environment variables (plain text), then review before enabling.
TERMS_TEXT=
PRIVACY_TEXT=
SELLER_NAME=Albino Cipolla
SELLER_STREET=Nahestr. 5
SELLER_POSTCODE=55118
SELLER_CITY=Mainz
SELLER_PHONE=01523-6183155
SELLER_EMAIL=info@streusalz-grosshandel.de
SELLER_TAX_ID=
SELLER_BANK_NAME=
SELLER_IBAN=
SELLER_BIC=
# Protect the Vercel mail-outbox cron.
CRON_SECRET=
