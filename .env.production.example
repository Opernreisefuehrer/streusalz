# Vercel Production only. This is a template, not a configured account.
# Enter real secrets in Vercel; never commit a completed environment file.
SITE_URL=https://www.streusalz-grosshandel.de
SITE_INDEXING_ENABLED=true
SHOP_ENABLED=false
LEGAL_READY=false

# Neon Connect: pooled URL for the app, direct URL for migrations.
# Copy the complete URLs including Neon TLS parameters. No placeholder credentials.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Artfiles: full mailbox address and mailbox password, not the DCP password.
SMTP_HOST=smtp.artfiles.de
SMTP_PORT=587
SMTP_USER=info@streusalz-grosshandel.de
SMTP_PASSWORD=
MAIL_FROM=info@streusalz-grosshandel.de
MAIL_MODE=smtp
ADMIN_EMAIL=info@streusalz-grosshandel.de
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=

# OpenRouteService key stays server-side; enable geocoding and driving-hgv access.
ORS_API_KEY=

SELLER_NAME=Albino Cipolla
SELLER_STREET=Nahestr. 5
SELLER_POSTCODE=55118
SELLER_CITY=Mainz
SELLER_PHONE=01523-6183155
SELLER_EMAIL=info@streusalz-grosshandel.de
